<?xml version="1.0" encoding="utf-8"?>
<!--
  Chemins exposés par le FileProvider déclaré dans AndroidManifest.xml, pour l'installeur
  système de mise à jour (voir lib/update/update_checker.dart et MainActivity.kt).

  `<files-path path=".">` correspond à l'intégralité de `Context.getFilesDir()` — c'est-à-dire
  tout le stockage interne de l'appli accessible depuis Dart (path_provider :
  `getApplicationDocumentsDirectory()` ET `getApplicationSupportDirectory()`, toutes deux des
  répertoires sous `getFilesDir()` sur Android, quel que soit le sous-dossier exact que
  path_provider choisit selon sa version — jamais un chemin codé en dur ici qui pourrait se
  désynchroniser silencieusement d'un changement de version du paquet). L'APK téléchargé est
  écrit par UpdateChecker.download dans `<ApplicationSupportDirectory>/updates/`, donc couvert.

  Volontairement large (tout `getFilesDir()`, pas seulement `updates/`) plutôt que de deviner un
  sous-chemin exact non documenté de façon stable par path_provider — sans risque supplémentaire
  réel : `android:exported="false"` sur le provider, et `grantUriPermissions` limite de toute
  façon l'accès à l'URI précise transmise à l'installeur, jamais à l'arborescence entière pour
  n'importe quelle appli tierce.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="app_files" path="." />
</paths>
