<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau : requis pour Matrix. INTERNET seul ; pas d'accès SMS/contacts/appels. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Mises à jour (voir lib/update/ et docs/UPDATES.md) : requise depuis Android 8 (API 26)
         pour qu'une appli installée hors Play Store puisse en proposer l'installation d'une
         autre (ici, une nouvelle version d'elle-même). N'accorde AUCUN droit d'installation
         silencieuse : Android affiche toujours son propre écran de confirmation, et vérifie
         lui-même que la signature du nouvel APK correspond à celle déjà installée avant
         d'autoriser quoi que ce soit — voir MainActivity.kt (installApk) et
         docs/UPDATES.md. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Mode Bluetooth maillé (hors-ligne). BLUETOOTH_ADVERTISE est annoté `usesPermissionFlags`
         "neverForLocation" : Murmure n'utilise jamais le Bluetooth pour géolocaliser qui que ce
         soit, seulement pour échanger des messages chiffrés de proche en proche. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Android < 12 exige la localisation pour scanner en BLE ; jamais lue par Murmure. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Caméra : lecture de QR codes pour ajouter un contact (jamais d'enregistrement), ET flux
         vidéo d'appel (voir lib/calls/). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Appels audio/vidéo (voir lib/calls/ et docs/CALLS_ARCHITECTURE.md). Pas de permission
         distincte pour les données WebRTC elles-mêmes : contrairement à ce qu'une note reçue
         pendant le développement suggérait, `android:allowBackup="false"` (déjà réglé ci-dessous,
         au niveau <application>) couvre déjà TOUTES les données de l'appli, y compris tout cache
         créé par le plugin d'appel — il n'existe pas de drapeau "allowBackup" séparé par
         fonctionnalité ou par bibliothèque en Android. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Notification d'appel manqué (voir lib/calls/services/call_opsec_notifier.dart), requise
         à partir d'Android 13 (API 33) pour qu'une appli puisse afficher quoi que ce soit dans la
         barre d'état — avant cette version, aucune permission explicite n'est demandée côté OS. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Service de premier plan du mode Bluetooth maillé (voir MeshForegroundService.kt et
         lib/mesh/mesh_foreground_service.dart). Trouvé en audit interne : sans ce service, le mode
         Bluetooth ne survivait à rien — ni l'appli mise en arrière-plan, ni l'écran verrouillé —
         puisque rien ne protégeait le processus d'être tué par Android, alors que c'est l'usage
         même visé (manifestation, téléphone en poche) qui exige que le relais continue sans
         l'appli à l'écran. `connectedDevice` est le type introduit en Android 14 (API 34) pour une
         interaction Bluetooth continue (voir la doc Android : prérequis satisfait ici par
         BLUETOOTH_SCAN/CONNECT/ADVERTISE, déjà demandés en exécution avant le démarrage du mode). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:label="Murmure"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Activité principale, SANS filtre LAUNCHER : c'est l'un des deux alias ci-dessous qui
             sert de point d'entrée visible, selon le mode discret (voir MainActivity.kt). La
             désactiver directement rendrait l'appli impossible à relancer — seuls les alias sont
             basculés. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <meta-data
                android:name="flutterEmbedding"
                android:value="2" />
        </activity>

        <!-- Icône/libellé "Murmure" — activée par défaut. -->
        <activity-alias
            android:name=".DefaultAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Murmure">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Icône/libellé "Calculatrice" — désactivée par défaut, activée depuis les réglages
             (mode discret). Voir MainActivity.kt : seul cet alias bascule, jamais MainActivity. -->
        <activity-alias
            android:name=".CalculatorAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calculator"
            android:label="Calculatrice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Voir MeshForegroundService.kt : fait survivre le mode Bluetooth maillé à la mise en
             arrière-plan de l'appli (usage visé : téléphone en poche pendant une manifestation).
             Jamais exportée : démarrée uniquement par MainActivity, dans le même processus. -->
        <service
            android:name=".MeshForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Mises à jour (voir lib/update/, MainActivity.kt et docs/UPDATES.md) : nécessaire pour
             donner à l'installeur système un accès en lecture, temporaire et révocable, à l'APK
             téléchargé — Android interdit depuis l'API 24 de partager directement un chemin
             file:// avec une autre appli (dont l'installeur lui-même). Jamais exportée au sens où
             d'autres applis pourraient l'interroger librement : `grantUriPermissions` limite
             l'accès à l'URI précise transmise par MainActivity.kt, pour la seule durée de
             l'intent d'installation. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
