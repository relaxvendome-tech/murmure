{$MURMURE_DOMAIN} {
	# Mises à jour de l'appli (voir docs/UPDATES.md et lib/update/) : chemin distinct du reste,
	# servi en fichiers statiques depuis le volume monté par docker-compose.yml
	# (`./updates:/srv/updates:ro`) — jamais proxyfié vers Conduit. `route` impose explicitement
	# cet ordre (sinon la correspondance de chemin la plus générale du `reverse_proxy` ci-dessous
	# intercepterait aussi ces requêtes). `no-store` : un manifeste périmé mis en cache côté client
	# ou par un relais intermédiaire ferait proposer une version déjà remplacée, ou pire,
	# empêcherait de voir une mise à jour de sécurité critique.
	route {
		handle_path /updates/* {
			root * /srv/updates
			header Cache-Control "no-store"
			file_server
		}
		handle {
			reverse_proxy conduit:6167
		}
	}

	# En-têtes de sécurité : pas de mise en cache des réponses chiffrées, pas d'intégration dans
	# une iframe tierce.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	# Journaux minimaux : adresse IP masquée, pas d'enregistrement du corps des requêtes
	# (qui contiendrait des événements Matrix chiffrés — aucune raison de les journaliser).
	#
	# Trouvé en audit interne (revue indépendante) : `request>remote_ip` seul ne suffit plus
	# depuis Caddy 2.7 (l'image `caddy:2-alpine` suit la dernière version stable) — le champ
	# structuré du log s'est enrichi d'un `request>client_ip` distinct (résolu via
	# `trusted_proxies`/en-têtes `X-Forwarded-For` le cas échéant, sinon identique à `remote_ip`),
	# non couvert par le filtre précédent. Sans cette ligne, l'IP de chaque client était quand
	# même écrite en clair dans access.log, à l'inverse exact de ce que ce commentaire annonçait —
	# grave vu le modèle de menace visé (saisie du serveur, pas seulement du téléphone).
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}
